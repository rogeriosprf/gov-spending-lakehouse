# Copy this file to .streamlit/secrets.toml (which is gitignored) and
# fill in the real values from your SQL Warehouse.
#
# Where to find each value:
# - DATABRICKS_SERVER_HOSTNAME and DATABRICKS_HTTP_PATH: in Databricks,
#   go to "SQL Warehouses" > select your warehouse (e.g. "Serverless
#   Starter Warehouse") > "Connection details" tab.
# - DATABRICKS_TOKEN: your user menu > "Settings" > "Developer" >
#   "Access tokens" > "Generate new token". Make sure the "sql" scope
#   is included (or select all scopes), otherwise you'll get a
#   "does not have required scopes: sql" error.

DATABRICKS_SERVER_HOSTNAME = "dbc-xxxxxxx-xxxx.cloud.databricks.com"
DATABRICKS_HTTP_PATH = "/sql/1.0/warehouses/xxxxxxxxxxxxxxxx"
DATABRICKS_TOKEN = "dapi_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
