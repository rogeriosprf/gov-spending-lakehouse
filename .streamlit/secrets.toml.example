# Copie este arquivo para .streamlit/secrets.toml (que é ignorado pelo git)
# e preencha com os valores reais do seu SQL Warehouse.
#
# Onde encontrar:
# - DATABRICKS_SERVER_HOSTNAME e DATABRICKS_HTTP_PATH: no Databricks,
#   vá em "SQL Warehouses" > selecione o warehouse (ex: "Serverless
#   Starter Warehouse") > aba "Connection details".
# - DATABRICKS_TOKEN: no seu usuário > "Settings" > "Developer" >
#   "Access tokens" > "Generate new token".

DATABRICKS_SERVER_HOSTNAME = "dbc-xxxxxxx-xxxx.cloud.databricks.com"
DATABRICKS_HTTP_PATH = "/sql/1.0/warehouses/xxxxxxxxxxxxxxxx"
DATABRICKS_TOKEN = "dapi_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
